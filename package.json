{
  "name": "aomori-yorimichi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/Aomori-tourism-map/",
    "preview": "vite preview --host 0.0.0.0",
